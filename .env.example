# Copy to /etc/vault-mcp.env, fill in, then: chown root:root, chmod 600.

# --- Required ---------------------------------------------------------------
# Absolute path of the vault folder on the server.
VAULT_ROOT=/srv/vault
# The public address of this server, without a trailing slash and without /mcp.
PUBLIC_BASE_URL=https://mcp.example.com
# GitHub usernames that may read the vault, comma-separated.
ALLOWED_GITHUB_LOGINS=your-github-login
# From the GitHub OAuth App (github.com/settings/developers).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate: openssl rand -hex 32
JWT_SIGNING_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=

# --- Optional ---------------------------------------------------------------
# Where client registrations and tokens are kept (encrypted). Must be writable.
STATE_DIR=/var/lib/vault-mcp
# Folder names hidden at any depth.
VAULT_EXCLUDE_DIRS=.git,.obsidian,.trash,Attachments
# Vault-relative paths never listed, searched or read. "Folder/" hides a
# folder; an entry without a trailing slash is a filename prefix.
VAULT_EXCLUDE_PREFIXES=
# Regex. Any note whose filename or body matches is withheld from every tool.
VAULT_SENSITIVE_PATTERN=
# Readable by path, left out of search unless include_archive=true.
VAULT_ARCHIVE_PREFIX=Archive/
# Name and instructions the connector shows to the model.
SERVER_NAME=obsidian-vault
SERVER_INSTRUCTIONS=
# Redirect URIs that may register as an OAuth client, comma-separated.
ALLOWED_CLIENT_CALLBACKS=https://claude.ai/api/mcp/auth_callback

# --- Optional task tools ------------------------------------------------------
# A Markdown task file in Obsidian Tasks format switches on search_tasks.
TASKS_MD_PATH=
TASKS_DONE_PATH=
# A Todoist API token switches on add_task (the server's only write).
TODOIST_API_KEY=
